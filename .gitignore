/target
.venv*/
*.db
*.db-wal
*.db-shm
.env
.info
.env.local
deploy/config.toml
/dist
/dist-v1
/dist-*

# Local scratch / draft notes that should never be committed.
# Root-only patterns: docs/**.md and CHANGELOG.md are unaffected.
/guide*.md
/version*.md
/plan*.md
/notes*.md
/draft*.md
/scratch*.md

# Security audit: full threat map with exact code paths. Internal only —
# must never reach the public repo.
/SECURITY-AUDIT.md

# Private context for Claude Code sessions. Workstation-specific,
# may reference local paths or tokens — never committed.
CLAUDE.md
.claude/

# Local editor metadata (Obsidian vault state over the repo).
.obsidian/

# Tauri build artifacts
crates/hoard-desktop/gen/

# Frontend build artifacts
crates/hoard-desktop/ui/node_modules/
crates/hoard-desktop/ui/dist/
crates/hoard-desktop/ui/.vite/

# Compiled Pro sidecar (`hoard-screen-<triple>`), built from the in-repo
# `crates/hoard-screen` crate and dropped here by the build so the bundler
# flattens it adjacent to the app exe (the runtime sidecar resolver finds it
# there; the old `binaries/` subdir broke runtime resolution). The compiled
# artifact is never committed — the source lives in `crates/hoard-screen`.
crates/hoard-desktop/binaries/
crates/hoard-desktop/hoard-screen-*

# This project uses pnpm — npm/yarn lockfiles dropped in by accident
# (e.g. running `npm install` against the same package.json) shouldn't
# be tracked. pnpm-lock.yaml is the source of truth.
package-lock.json
yarn.lock

# Stray archives accidentally dropped in the tree (e.g. an exported
# `hoard-agent.zip`) — build/scratch artifacts, never source.
*.zip

# Mapa de saves: prototipo aparcado (defectuoso, fuera de 1.0). Se mantiene
# en local para retomarlo, pero no se publica.
crates/hoard-desktop/ui/src/routes/Map.svelte

# Backlog de trabajo local (futuros cambios), nunca al repo.
/TODO.local.md

# Revisión + recolección de datos del pipeline de detección. Local.
/DETECTION.local.md

# Notas de cambios por versión + dónde tocar. Local.
/CAMBIOS-1.0.2.local.md

# Dashboard de métricas admin (usa service_role). Solo local, nunca al repo.
/tools/admin-dashboard.html
# Su migración/RPC (admin_metrics con mi uid). Se aplica a mano en prod.
/crates/hoard-server/migrations/postgres/0030_admin_metrics.sql

# Visión del rediseño del CLI. Doc de trabajo local.
/HOARD-CLI.local.md

# Idea del plugin de Decky para el CLI. Nota de trabajo local.
/hoard-cli-deckyplugin.local.md

# Prompt de handoff: fixes de sync en Windows. Nota de trabajo local.
/hoard-cli-windows-sync-fixes.local.md

# Lista de tareas del usuario (solo la escribe él). Nunca al repo.
/rleeon.md
/vista.md

# Bot de estado de Discord (infra local, secretos). Nunca al repo.
/deploy/.env.discord-bot
/deploy/scripts/discord-status-bot.py
/deploy/systemd/hoard-discord-bot.service
