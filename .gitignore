# Dashboard de métricas admin (usa service_role). Solo local, nunca al repo.
/tools/admin-dashboard.html
/tools/serve-dashboard.sh
# Su migración/RPC (admin_metrics con mi uid). Se aplica a mano en prod.
/crates/hoard-server/migrations/postgres/0030_admin_metrics.sql
# La v2 de esa misma RPC lleva el uid empotrado igual que la 0030, así que se
# ignora por lo mismo y se aplica a mano. Ojo: `sqlx::migrate!` empotra la
# carpeta en tiempo de compilación y aborta el arranque con `VersionMissing`
# si la base tiene aplicada una versión que el binario no trae — por eso el
# server cloud se construye desde este árbol (deploy/fly/Dockerfile), donde
# los dos ficheros sí están en disco, y no desde un clon limpio del repo.
# Desde el 2026-08-13 eso ya no es sólo una regla que hay que recordar: el
# migrador va con `set_ignore_missing(true)` (cloud/db.rs), así que un build
# sin estos ficheros arranca en vez de quedarse en bucle de reinicios. Se
# perdió una mañana de servicio aprendiéndolo: despliegue desde un worktree,
# `VersionMissing(30)`, y la API abajo hasta el rollback.
/crates/hoard-server/migrations/postgres/0039_admin_metrics_v2.sql
# Screen's own admin metrics: a separate function so that touching them never
# means rewriting the 706-line body of `admin_metrics()`, but the same embedded
# uid and therefore the same rule — ignored here, applied by hand in prod.
/crates/hoard-server/migrations/postgres/0044_admin_metrics_screen.sql

